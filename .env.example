# Copy to .env and adjust locally. Real .env files are never committed.

# Backend API (backend/api)
API_PORT=4000

# Base URL that clients use to reach the backend API.
# Clients talk only to the backend; they never connect to PostgreSQL directly.
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000
EXPO_PUBLIC_API_BASE_URL=http://localhost:4000
